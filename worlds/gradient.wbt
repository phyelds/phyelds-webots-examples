#VRML_SIM R2025a utf8
# 32 Elisa-3 stand still; a red spot lights four of them, and each robot shows how far it is from them.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/SwarmElisa.proto"

WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  orientation -0.3574 0.3574 0.8629 1.7178
  position 0.0 -0.75 0.75
}
Background {
  luminosity 0.1
  skyColor [
    0.15 0.15 0.18
  ]
}
DirectionalLight {
  direction 0.2 0.3 -1
  intensity 0.4
  castShadows FALSE
}
RectangleArena {
  floorSize 1.0 0.6
  floorTileSize 0.2 0.2
  wallHeight 0.03
  floorAppearance PBRAppearance {
    baseColor 0.2 0.2 0.22
    roughness 1
    metalness 0
  }
}
SpotLight {
  location -0.3 -0.1 0.6
  direction 0 0 -1
  color 1 0 0
  intensity 1
  attenuation 0 0 1
  beamWidth 0.1340
  cutOffAngle 0.1489
  castShadows FALSE
}
